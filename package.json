{
  "name": "celestia-validator-notification",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -n web,worker,bot -c blue,green,magenta \"next dev\" \"tsx watch src/worker/index.ts\" \"tsx watch src/telegram-bot/index.ts\"",
    "dev:web": "next dev",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:bot": "tsx watch src/telegram-bot/index.ts",
    "build": "next build",
    "prestart": "prisma migrate deploy",
    "start": "concurrently -n web,worker,bot -c blue,green,magenta \"next start\" \"tsx src/worker/index.ts\" \"tsx src/telegram-bot/index.ts\"",
    "start:web": "next start",
    "start:worker": "tsx src/worker/index.ts",
    "start:bot": "tsx src/telegram-bot/index.ts",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "tsx watch src/worker/index.ts",
    "bot:dev": "tsx watch src/telegram-bot/index.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@keplr-wallet/cosmos": "^0.12.176",
    "@next/third-parties": "^14.2.18",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "grammy": "^1.30.0",
    "jose": "^5.10.0",
    "lucide-react": "^0.460.0",
    "next": "14.2.18",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.12.4",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@keplr-wallet/types": "^0.12.176",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
